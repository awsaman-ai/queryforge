{
  "root": "customer",
  "select": [{ "field": "customer.name" }],
  "where": [
    { "kind": "compare", "field": "product.category", "via": ["customer_orders", "order_product"], "op": "eq", "values": [{ "string": "laptop" }] },
    { "kind": "compare", "field": "order.amount", "via": ["customer_orders"], "op": "gt", "values": [{ "number": 1000 }] }
  ]
}
