{
  "entity": "Order",
  "backends": {
    "elasticsearch": {
      "routing": {
        "strategy": "ifElse",
        "branches": [
          {
            "if": {
              "field": "createdAt",
              "operator": "gte",
              "value": "2026-01-01"
            },
            "indexes": [
              "orders-2026"
            ]
          },
          {
            "else": true,
            "indexes": [
              "orders-legacy"
            ]
          }
        ],
        "default": [
          "orders-fallback"
        ]
      }
    }
  },
  "fields": [
    {
      "name": "createdAt",
      "type": "date",
      "routingField": true
    }
  ]
}
